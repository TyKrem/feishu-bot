{
  // TypeScript 只当类型检查器用，不产出 JS：服务在 Node 16 上跑，
  // 部署方式又是直接拷 server/ 目录，加构建步骤不划算。
  // 所以这里 allowJs + checkJs，源码保持 JS，靠 JSDoc 标注类型。
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "types": ["node"],

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    // 全量 strict。原来的渐进路线（先只对 lib/ 开 noImplicitAny）已经走完，
    // 现在整个 server/ 都标了 JSDoc，不需要再分两份配置。
    "strict": true
  },
  "include": ["server/**/*.js"],
  "exclude": ["node_modules"]
}
