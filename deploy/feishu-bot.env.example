# ===== 飞书自建应用凭据（必填）=====
# 飞书开放平台 → 开发者后台 → 你的应用 → 凭证与基础信息
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# feishu = 飞书（国内版，open.feishu.cn）；lark = Lark（国际版，open.larksuite.com）
FEISHU_DOMAIN=feishu

# ===== 白名单（首次接入可留空，机器人会回报你的 open_id）=====
# 允许私聊的用户，填 open_id / user_id / union_id，逗号分隔
FEISHU_ALLOW_USERS=
# 允许的群聊 chat_id（群聊里需要 @机器人 才会响应），逗号分隔
FEISHU_ALLOW_CHATS=
# 受限用户：只允许纯文字聊天与生活指令，不能执行系统命令（填 open_id）
FEISHU_RESTRICTED_USERS=

# ===== 推送与通知 =====
# 默认收件人 open_id：启动通知、定时任务推送默认发给他
FEISHU_NOTIFY_USER=
# 内部通知接口令牌（供 scheduler-app 等本地程序调用）
FEISHU_NOTIFY_TOKEN=
FEISHU_INTERNAL_HOST=127.0.0.1
FEISHU_INTERNAL_PORT=8796

# ===== 机器人身份（群聊判断是否被 @，可选）=====
FEISHU_BOT_OPEN_ID=
FEISHU_BOT_NAME=

# ===== 图片 =====
# 塔罗牌指令是否附带牌面图片（1 开 / 0 关）。需要飞书 im:resource 权限，
# 牌面取自 Wikimedia Commons 的公有领域牌组并缓存在 FEISHU_DATA_DIR/tarot
FEISHU_TAROT_IMAGE=1

# ===== 生活数据键映射（沿用 QQ 时代数据时使用）=====
# 格式：飞书 open_id=旧QQ号，多项用逗号分隔
# 例：FEISHU_LIFE_KEY_MAP=ou_xxxxxxxx=10001
FEISHU_LIFE_KEY_MAP=
# 可选：定时任务里写的旧 QQ 号 → 飞书 open_id（不填则用上面的映射自动反查）

# ===== Codex =====
FEISHU_CODEX_BIN=/opt/codex/bin/codex
FEISHU_WORKSPACE=/root
FEISHU_CODEX_HOME=/root/.codex-feishu
FEISHU_DATA_DIR=/opt/feishu-bot/data
FEISHU_MAX_ACTIVE=2
FEISHU_TURN_TIMEOUT=900

# ===== 回复随机延迟（秒），min,max；0 表示关闭 =====
FEISHU_REPLY_DELAY_MIN=0.8
FEISHU_REPLY_DELAY_MAX=2.5

# ===== 日志 / 健康时间线 =====
FEISHU_LOG_URL=http://127.0.0.1:8792/api/v1/logs
FEISHU_LOG_TOKEN=
FEISHU_HEALTH_LOG=/var/log/feishu-bot-health.log
