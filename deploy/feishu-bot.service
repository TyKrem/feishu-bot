[Unit]
Description=飞书消息入口与通知服务
After=network-online.target log-center.service feishu-executor.service
Wants=network-online.target log-center.service feishu-executor.service

[Service]
Type=simple
User=feishu-bot
Group=feishu-bot
EnvironmentFile=/etc/feishu-bot.env
Environment="PATH=/opt/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
WorkingDirectory=/opt/feishu-bot
ExecStart=/opt/node/bin/node /opt/feishu-bot/server/server.js
Restart=always
RestartSec=5
RestartPreventExitStatus=78
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/feishu-bot/data /opt/life-app/data /var/log/feishu-bot-health.log
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true

[Install]
WantedBy=multi-user.target
