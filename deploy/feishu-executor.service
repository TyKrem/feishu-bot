[Unit]
Description=飞书独立运维执行器
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=feishu-bot
EnvironmentFile=/etc/feishu-bot.env
EnvironmentFile=/etc/feishu-executor.env
Environment="PATH=/opt/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
WorkingDirectory=/opt/feishu-bot
ExecStart=/opt/node/bin/node /opt/feishu-bot/server/executor/server.js
RuntimeDirectory=feishu-executor
RuntimeDirectoryMode=0750
StateDirectory=feishu-executor
StateDirectoryMode=0700
# 模型创建源码需沿用普通文件权限；私有状态始终显式600、目录700。
UMask=0022
Restart=on-failure
RestartSec=5
TimeoutStopSec=8
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
